{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sistemista.dev/osbench/benchmark.schema.json",
  "title": "Sistemista OS-Scenario Benchmark Case",
  "description": "A single fully-structured scenario for evaluating a terminal-only autonomous AI Systems-Engineering agent.",
  "type": "object",
  "required": [
    "id", "title", "difficulty", "os", "domain", "prerequisites", "scenario",
    "environment", "initial_state", "expected_reasoning", "expected_commands",
    "forbidden_commands", "safety_constraints", "success_criteria",
    "failure_criteria", "success_check", "recovery_strategy", "ground_truth",
    "expected_time_s", "expected_token_budget", "possible_mistakes", "hints",
    "reference_solution", "alternative_solution", "edge_cases", "risk", "goal"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]{3}-[A-Z0-9_]+-[0-9]{5}$" },
    "title": { "type": "string", "minLength": 8 },
    "difficulty": { "enum": ["easy", "medium", "hard", "expert", "principal"] },
    "os": { "enum": ["linux", "windows", "macos"] },
    "domain": { "type": "string", "minLength": 2 },
    "goal": { "type": "string", "minLength": 8 },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "scenario": { "type": "string", "minLength": 20 },
    "environment": { "type": "object" },
    "initial_state": { "type": "array", "items": { "type": "string" } },
    "expected_reasoning": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "expected_commands": { "type": "array", "items": { "type": "string" } },
    "forbidden_commands": { "type": "array", "items": { "type": "string" } },
    "safety_constraints": { "type": "array", "items": { "type": "string" } },
    "success_criteria": { "type": "string", "minLength": 10 },
    "failure_criteria": { "type": "string" },
    "success_check": { "$ref": "#/$defs/verify" },
    "failure_check": { "anyOf": [ { "$ref": "#/$defs/verify" }, { "type": "null" } ] },
    "recovery_strategy": { "type": "string" },
    "ground_truth": { "type": "object" },
    "expected_time_s": { "type": "integer", "minimum": 1 },
    "expected_token_budget": { "type": "integer", "minimum": 1 },
    "possible_mistakes": { "type": "array", "items": { "type": "string" } },
    "hints": { "type": "array", "items": { "type": "string" } },
    "reference_solution": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "alternative_solution": { "type": "array", "items": { "type": "string" } },
    "edge_cases": { "type": "array", "items": { "type": "string" } },
    "risk": { "enum": ["SAFE", "RECOVERABLE", "DESTRUCTIVE"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "golden": { "type": "boolean" },
    "family": { "type": "string" },
    "schema_version": { "type": "string" },
    "signature": { "type": "string" }
  },
  "$defs": {
    "verify": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "artifact", "file_contains", "file_absent", "file_mode", "file_owner",
            "process_running", "process_absent", "port_listening", "port_closed",
            "service_active", "service_inactive", "command_succeeds", "command_stdout",
            "http_ok", "package_installed", "package_absent", "kv_equals", "refused",
            "all_of", "any_of", "none_of"
          ]
        },
        "path": { "type": "string" },
        "pattern": { "type": "string" },
        "mode": { "type": "string" },
        "owner": { "type": "string" },
        "group": { "type": "string" },
        "port": { "type": "integer" },
        "proto": { "enum": ["tcp", "udp"] },
        "name": { "type": "string" },
        "probe": { "type": "string" },
        "url": { "type": "string" },
        "status": { "type": "array", "items": { "type": "integer" } },
        "selector": { "type": "string" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/verify" } },
        "note": { "type": "string" }
      }
    }
  }
}
